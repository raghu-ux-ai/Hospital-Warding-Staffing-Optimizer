        "# ============================================================\n",
        "# HOSPITAL WARD STAFFING OPTIMIZER\n",
        "# B.Tech Mathematics Mini Project\n",
        "# Method: Gauss Elimination\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# -------------------- INPUTS --------------------\n",
        "\n",
        "wards = [\"Ward A\", \"Ward B\", \"Ward C\"]\n",
        "staff_types = [\"Senior Nurse\", \"Junior Nurse\", \"Assistant\"]\n",
        "\n",
        "# Assumption:\n",
        "# Each column represents staff-hours contributed by one\n",
        "# unit of the corresponding staff type.\n",
        "\n",
        "A = np.array([\n",
        "    [2.0, 1.0, 0.5],   # Ward A\n",
        "    [1.0, 2.0, 1.0],   # Ward B\n",
        "    [0.5, 1.0, 2.0]    # Ward C\n",
        "])\n",
        "\n",
        "# Required staff-hours\n",
        "B = np.array([20.0, 25.0, 15.0])\n",
        "\n",
        "# Cost per hour\n",
        "cost = np.array([800.0, 400.0, 200.0])\n",
        "\n",
        "\n",
        "# ---------------- GAUSS ELIMINATION ----------------\n",
        "\n",
        "def gauss_elimination(A, B):\n",
        "\n",
        "    # Create augmented matrix [A | B]\n",
        "    M = np.column_stack((A.astype(float), B.astype(float)))\n",
        "\n",
        "    n = len(B)\n",
        "\n",
        "    for i in range(n):\n",
        "\n",
        "        # Partial pivoting\n",
        "        pivot = i + np.argmax(abs(M[i:, i]))\n",
        "\n",
        "        if abs(M[pivot, i]) < 1e-12:\n",
        "            raise ValueError(\"No unique solution exists.\")\n",
        "\n",
        "        # Swap rows\n",
        "        M[[i, pivot]] = M[[pivot, i]]\n",
        "\n",
        "        # Make pivot = 1\n",
        "        M[i] = M[i] / M[i, i]\n",
        "\n",
        "        # Eliminate other rows\n",
        "        for j in range(n):\n",
        "\n",
        "            if j != i:\n",
        "                factor = M[j, i]\n",
        "                M[j] = M[j] - factor * M[i]\n",
        "\n",
        "    return M[:, -1]\n",
        "\n",
        "\n",
        "# ---------------- SOLVE AX = B ----------------\n",
        "\n",
        "X = gauss_elimination(A, B)\n",
        "\n",
        "# Staffing quantities\n",
        "senior, junior, assistant = X\n",
        "\n",
        "# Calculate actual hours\n",
        "calculated_hours = A @ X\n",
        "\n",
        "# Total cost\n",
        "total_cost = np.dot(X, cost)\n",
        "\n",
        "\n",
        "# ---------------- OUTPUT ----------------\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"       HOSPITAL WARD STAFFING OPTIMIZER\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(\"\\nMATHEMATICAL MODEL:\")\n",
        "print(\"AX = B\")\n",
        "\n",
        "print(\"\\nMatrix A:\")\n",
        "print(A)\n",
        "\n",
        "print(\"\\nRequired Hours B:\")\n",
        "print(B)\n",
        "\n",
        "print(\"\\nStaffing Solution:\")\n",
        "for staff, value in zip(staff_types, X):\n",
        "    print(f\"{staff:<15}: {value:.4f}\")\n",
        "\n",
        "print(\"\\nTOTAL COST:\")\n",
        "print(f\"Rs. {total_cost:,.2f}\")\n",
        "\n",
        "# Verification\n",
        "print(\"\\nVERIFICATION:\")\n",
        "print(\"Required Hours :\", B)\n",
        "print(\"Calculated Hours:\", np.round(calculated_hours, 4))\n",
        "\n",
        "if np.allclose(calculated_hours, B):\n",
        "    print(\"✓ AX = B verified successfully.\")\n",
        "\n",
        "\n",
        "# ---------------- RESULT TABLE ----------------\n",
        "\n",
        "result = pd.DataFrame({\n",
        "    \"Staff Type\": staff_types,\n",
        "    \"Quantity\": X,\n",
        "    \"Cost/Hour (Rs.)\": cost,\n",
        "    \"Cost Contribution (Rs.)\": X * cost\n",
        "})\n",
        "\n",
        "print(\"\\nSTAFFING RESULT TABLE:\")\n",
        "display(result.round(4))\n",
        "\n",
        "\n",
        "# ---------------- CHART 1 ----------------\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.bar(wards, B, label=\"Required Hours\")\n",
        "plt.bar(wards, calculated_hours, alpha=0.7,\n",
        "        label=\"Calculated Hours\")\n",
        "\n",
        "plt.xlabel(\"Hospital Ward\")\n",
        "plt.ylabel(\"Staff-Hours\")\n",
        "plt.title(\"Required vs Calculated Staff-Hours\")\n",
        "plt.legend()\n",
        "plt.grid(axis=\"y\", alpha=0.3)\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ---------------- CHART 2 ----------------\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.bar(staff_types, X)\n",
        "\n",
        "plt.xlabel(\"Staff Type\")\n",
        "plt.ylabel(\"Staff Quantity\")\n",
        "plt.title(\"Calculated Staffing Mix\")\n",
        "plt.grid(axis=\"y\", alpha=0.3)\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ---------------- FINAL SUMMARY ----------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"FINAL CONCLUSION\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(\n",
        "    \"Gauss elimination was used to solve the system AX = B. \"\n",
        "    \"The resulting staffing mix satisfies the required staff-hours \"\n",
        "    \"for all three hospital wards.\"\n",
        ")"
      ]
